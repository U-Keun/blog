STYLE_SETTINGS_BODY_CLASSES=theme-dark mod-macos is-frameless is-hidden-frameless obsidian-app is-translucent show-inline-title show-ribbon show-view-header mk-readable-line mk-folder-lines mk-spaces-enabled mk-inline-context-enabled mk-flow-replace mk-flow-minimal css-settings-manager ctp-rosepine-light ctp-mocha-old ctp-accent-light-blue ctp-accent-lavender anuppuccin-accent-toggle anp-no-highlight anp-latex-inline-text anp-latex-block-text anp-td-none anp-color-transition-toggle anp-toggle-metadata anp-toggle-scrollbars anp-hide-status-bar anp-hide-external-link-icon anp-h1-red anp-h2-peach anp-h3-green anp-h4-teal anp-h5-lavender anp-h6-mauve anp-bold-red anp-italic-green anp-highlight-yellow anp-colorful-frame anp-colorful-frame-icon-toggle-dark anp-file-icons anp-collapse-folders anp-simple-rainbow-color-toggle anp-simple-rainbow-title-toggle anp-simple-rainbow-collapse-icon-toggle anp-simple-rainbow-indentation-toggle anp-simple-rainbow-icon-toggle anp-rainbow-subfolder-color-toggle anp-fixed-status-bar anp-safari-tab-toggle anp-bg-fix is-fullscreen is-focused
